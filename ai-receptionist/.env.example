# ─────────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill in what you have.
#  EVERY key is optional — anything left blank falls back to a
#  working demo stub, so the app always runs.
# ─────────────────────────────────────────────────────────────

# ── Claude (the receptionist's brain) ────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional. Default claude-opus-5. Use claude-sonnet-5 to cut cost ~2.5x.
CLAUDE_MODEL=claude-opus-5

# ── Supabase (leads + conversation history) ──────────────────
# https://supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar (booking) — service account ──────────────
# console.cloud.google.com → Service Accounts → JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
BOOKING_TIMEZONE=America/New_York

# ── Google login for /dashboard ──────────────────────────────
# console.cloud.google.com → Credentials → OAuth client ID (Web)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated emails allowed into the dashboard.
DASHBOARD_ALLOWED_EMAILS=
# Any long random string — signs the login cookie.
AUTH_SECRET=

# ── Google Maps (property locations) ─────────────────────────
# console.cloud.google.com → Credentials → API key → enable "Maps Embed API"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Vapi (voice calls) ───────────────────────────────────────
# https://dashboard.vapi.ai → API Keys
VAPI_PRIVATE_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# ── Public URL of this app (used by embed.js + OAuth callback) ─
NEXT_PUBLIC_APP_URL=http://localhost:3000
